# Wissendurst'27 — environment template. Copy to .env.local and fill in.
# Never commit real values (.env* files other than this one are gitignored).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only — never expose.
SUPABASE_SERVICE_ROLE_KEY=

# OCR (server only)
OCR_PROVIDER=ocrspace
OCR_API_KEY=

# Payments (shown on payment pages)
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_PAYEE_NAME=

# Public site URL (OG/sitemap/auth redirects), e.g. http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Consent-first PostHog Cloud EU analytics (D-024). Public project token
# (starts with phc_). Leave EMPTY to disable analytics completely: no consent
# banner, no Cookie preferences control, no SDK download, no network.
# Set it in Vercel for the Production environment only.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=

# D-025/D-026 super-admin /admin/analytics dashboard + saved heatmaps
# (SERVER ONLY — never prefix with NEXT_PUBLIC_). A PostHog personal API key
# scoped to this project with exactly query:read + heatmap:read (no write,
# session_recording or person scopes), and the numeric project ID. Leave
# empty: the page shows a "not configured" notice.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# Vercel Web Analytics needs no variables: enable it in the Vercel project
# (Analytics tab). It only runs after the same analytics consent.
